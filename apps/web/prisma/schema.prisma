generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String   @id
  name           String
  email          String   @unique
  emailVerified  Boolean  @default(false)
  image          String?
  dodoCustomerId String?  @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  accounts Account[]
  sessions Session[]

  threads Thread[]
  votes   Vote[]

  subscription Subscription?
  usagePeriods UsagePeriod[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

enum ResponseStatus {
  STREAMING
  COMPLETE
  FAILED

  @@map("response_status")
}

enum ModelTier {
  FREE
  STANDARD
  ADVANCED
  FRONTIER

  @@map("model_tier")
}

enum Plan {
  FREE
  PRO
  PRO_PLUS
  MAX

  @@map("plan")
}

enum BillingInterval {
  MONTHLY
  ANNUAL

  @@map("billing_interval")
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  ON_HOLD
  CANCELLED
  EXPIRED
  FAILED

  @@map("subscription_status")
}

enum UsageScope {
  DAILY
  BILLING

  @@map("usage_scope")
}

model Subscription {
  id                 String             @id @default(cuid())
  userId             String             @unique
  plan               Plan
  interval           BillingInterval
  status             SubscriptionStatus
  dodoSubscriptionId String             @unique
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean            @default(false)
  pastDueEndsAt      DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  lastEventAt        DateTime?
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscription")
}

model UsagePeriod {
  id          String          @id @default(cuid())
  userId      String
  scope       UsageScope
  periodStart DateTime
  periodEnd   DateTime
  freeAnswers Int             @default(0)
  standard    Int             @default(0)
  advanced    Int             @default(0)
  frontier    Int             @default(0)
  spentUsd    Decimal         @default(0) @db.Decimal(12, 6)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  responses   ModelResponse[]

  @@unique([userId, scope, periodStart])
  @@index([userId, scope])
  @@map("usage_period")
}

model Thread {
  id          String   @id @default(cuid())
  userId      String
  title       String
  titleLocked Boolean  @default(false)
  shareSlug   String?  @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  turns       Turn[]

  @@index([userId, createdAt])
  @@index([userId, updatedAt])
  @@map("thread")
}

model Turn {
  id        String          @id @default(cuid())
  threadId  String
  prompt    String
  createdAt DateTime        @default(now())
  thread    Thread          @relation(fields: [threadId], references: [id], onDelete: Cascade)
  responses ModelResponse[]
  vote      Vote?

  @@index([threadId, createdAt])
  @@map("turn")
}

model ModelResponse {
  id               String         @id @default(cuid())
  turnId           String
  modelId          String
  modelName        String
  status           ResponseStatus @default(STREAMING)
  content          String         @default("")
  failure          String?
  ttftMs           Int?
  durationMs       Int?
  promptTokens     Int?
  completionTokens Int?
  totalTokens      Int?
  tokensPerSecond  Decimal?       @db.Decimal(10, 2)
  costUsd          Decimal        @default(0) @db.Decimal(10, 6)
  costEstimated    Boolean        @default(false)
  tier             ModelTier      @default(FREE)
  usagePeriodId    String?
  usagePeriod      UsagePeriod?   @relation(fields: [usagePeriodId], references: [id], onDelete: SetNull)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  turn             Turn           @relation(fields: [turnId], references: [id], onDelete: Cascade)
  wonVotes         Vote[]

  @@index([turnId])
  @@index([usagePeriodId])
  @@index([modelId, status])
  @@map("model_response")
}

model WebhookEvent {
  id                 String   @id
  type               String
  eventAt            DateTime @map("occurredAt")
  dodoSubscriptionId String?
  processedAt        DateTime @default(now())

  @@map("webhook_event")
}

model Vote {
  id               String        @id @default(cuid())
  turnId           String        @unique
  winnerResponseId String
  userId           String
  createdAt        DateTime      @default(now())
  turn             Turn          @relation(fields: [turnId], references: [id], onDelete: Cascade)
  winnerResponse   ModelResponse @relation(fields: [winnerResponseId], references: [id], onDelete: Cascade)
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([winnerResponseId])
  @@map("vote")
}
